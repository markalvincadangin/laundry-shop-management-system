Project Faith_Laundry_Shop_System {
  database_type: 'PostgreSQL'
  Note: 'ERD for Faith Laundry Shop. Supports dynamic pricing, order lifecycle, payment recording, and reporting. Standardized on varchar for enums to ensure JPA/PostgreSQL casting stability. Forensic audit trail via database-level triggers writing to activity_logs.'
}

// --- ENUMS (Documented for Reference; Implemented as varchar) --- //
/*
  user_role: ADMIN, STAFF
  order_status: RECEIVED, WASHING, DRYING, FOLDING, READY_FOR_PICKUP, RELEASED, CANCELLED
  payment_status: UNPAID, PAID
  payment_method: CASH, GCASH, BANK_TRANSFER
  notification_status: PENDING, SENT, FAILED
  notification_channel: SMS, IN_APP
  activity_action: INSERT, UPDATE, DELETE, USER_LOGIN, ORDER_CREATE, ORDER_UPDATE, ORDER_STATUS_UPDATE, PAYMENT_RECORD, PAYMENT_VOID
*/

// --- AUDIT INFRASTRUCTURE --- //

Table activity_logs {
  id bigserial [pk]
  user_id varchar [null, note: 'Captured from SET LOCAL app.current_user_id via Spring Boot AOP']
  action_type varchar(10) [not null, note: 'INSERT, UPDATE, or DELETE']
  table_name varchar(100) [not null]
  record_id varchar(255) [not null]
  old_data jsonb [null, note: 'Snapshot before change (Trigger-based updates)']
  new_data jsonb [null, note: 'Snapshot after change (Trigger-based updates)']
  ip_address varchar(45) [null]
  user_agent text [null]
  status varchar(20) [null, note: 'SUCCESS or FAILURE']
  method_name varchar(255) [null]
  description text [null]
  created_at timestamp [not null, default: `now()`]

  Note: 'Forensic audit trail. Populated by fn_audit_activity() trigger on orders, payments, customers, service_rates. Replaces the previous order_status_logs approach.'
  Indexes {
    (table_name, record_id) [name: 'idx_activity_logs_table_record']
    created_at [name: 'idx_activity_logs_created_at']
  }
}

// --- CONFIGURATION --- //

Table service_rates {
  id int [pk, increment]
  service_name varchar [default: 'Standard Wash', note: 'Standard Wash-Dry-Fold']
  base_price_per_load decimal(10,2) [default: 120.00, note: 'BR-PR-01: ₱120 per load']
  kg_limit_per_load decimal(5,2) [default: 8.00, note: 'BR-PR-01: 8 kg limit per load']
  price_per_extra_minute decimal(10,2) [default: 1.00, note: 'BR-PR-03: ₱1 per extra minute']
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`, note: 'Auto-updated by trg_service_rates_updated_at trigger']

  Note: 'Stores pricing rules. Owner can update without code changes. Snapshot copied to orders at creation. Audited by trg_audit_service_rates trigger.'
}

// --- USERS & CUSTOMERS --- //

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  username varchar [unique, not null]
  password_hash varchar [not null]
  role varchar [not null, default: 'STAFF', note: 'ADMIN / STAFF']
  first_name varchar [not null]
  last_name varchar [not null]
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`, note: 'Auto-updated by trg_users_updated_at trigger']

  Note: 'System users. RBAC enforced: Admin vs Staff.'
}

Table customers {
  id bigserial [pk]
  first_name varchar [not null]
  last_name varchar [not null]
  contact_number varchar [not null]
  is_active boolean [not null, default: true, note: 'Soft delete flag']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`, note: 'Auto-updated by trg_customers_updated_at trigger']

  Note: 'BR-REC-01: Identity is a combination of name and contact. Audited by trg_audit_customers trigger.'
  Indexes {
    (last_name, first_name, contact_number) [unique]
  }
}

// --- ORDER MANAGEMENT --- //

Table orders {
  id bigserial [pk]
  reference_number varchar [unique, not null, note: 'BR-OL-01: LDR-YYYYMMDD-XXXX']
  customer_id bigint [ref: > customers.id, not null]
  created_by_user_id uuid [ref: > users.id, not null]

  // Load & Weight
  service_rate_id int [ref: > service_rates.id, not null]
  weight_kg decimal(10,2) [not null]
  total_loads int [not null, note: 'ceil(weight_kg / 8)']

  // Pricing snapshot
  base_price_per_load decimal(10,2) [not null]
  kg_limit_per_load decimal(5,2) [not null]
  price_per_extra_minute decimal(10,2) [not null]

  // Extra charges
  extra_minutes int [not null, default: 0]

  // Computed amounts
  base_amount decimal(10,2) [not null]
  extra_minutes_amount decimal(10,2) [not null]
  addons_total_amount decimal(10,2) [not null, default: 0]
  grand_total decimal(10,2) [not null]

  // Status
  current_status varchar [not null, default: 'RECEIVED', note: 'BR-OL-03']
  payment_status varchar [not null, default: 'UNPAID', note: 'BR-PAY-04']

  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`, note: 'Auto-updated by trg_orders_updated_at trigger']

  Note: 'BR-OL-05: Release requires READY_FOR_PICKUP and PAID status. Audited by trg_audit_orders trigger.'
  Indexes {
    reference_number [unique]
    (customer_id, created_at) [name: 'idx_orders_customer_created']
    current_status [name: 'idx_orders_status']
    payment_status [name: 'idx_orders_payment_status']
  }
}

Table order_add_ons {
  id bigserial [pk]
  order_id bigint [ref: > orders.id, not null]
  name varchar [not null]
  price decimal(10,2) [not null]
  quantity int [not null, default: 1]

  Note: 'BR-PR-04: Extra FabCon, etc.'
}

// --- PAYMENTS --- //

Table payments {
  id bigserial [pk]
  order_id bigint [ref: - orders.id, unique, not null]
  amount_paid decimal(10,2) [not null, note: 'BR-PAY-03: Must match grand_total']
  payment_method varchar [not null, default: 'CASH', note: 'CASH, GCASH, BANK_TRANSFER']
  received_by_user_id uuid [ref: > users.id, not null]
  payment_date timestamp [default: `now()`]
  remarks text

  Note: 'BR-PAY-02: Exactly one payment per order. Audited by trg_audit_payments trigger.'
  Indexes {
    payment_date [name: 'idx_payments_date']
  }
}

// --- NOTIFICATIONS --- //

Table notifications {
  id bigserial [pk]
  order_id bigint [ref: > orders.id, not null]
  channel varchar(30) [not null, default: 'IN_APP', note: 'SMS, IN_APP']
  message text [not null]
  created_at timestamp [default: `now()`]
  sent_at timestamp [null]
  status varchar(30) [not null, default: 'PENDING', note: 'PENDING, SENT, FAILED']
  is_read boolean [not null, default: false, note: 'In-app read status flag']

  Note: 'Notification queue. customer_id removed for 3NF compliance (derivable via order_id -> customer_id).'
}
