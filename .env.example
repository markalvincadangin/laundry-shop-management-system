# Faith Laundry Shop Management System — Root Environment Template
# Copy to .env for Docker Compose. NEVER commit .env to Git.
# See docs/GETTING_STARTED.md for setup instructions.
#
# For backend: Copy backend/.env.example to backend/.env
# For frontend: Copy frontend/.env.example to frontend/.env.local

# Database Configuration
DB_USER=laundry_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5433
DB_NAME=laundry_db

# Backend Configuration
SPRING_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=dev-only-change-me-in-production
ALLOWED_ORIGIN=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api
