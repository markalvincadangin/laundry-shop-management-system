# ============================================================
# Faith Laundry Shop — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#
# LOCAL DEV:   Uses Docker Compose (docker-compose.yml)
# PRODUCTION:  Set these in Render Dashboard → Environment
# ============================================================

# --- DATABASE CONFIG ---
# Local dev: Docker Compose Postgres
# Production (Render): Use Neon connection string components
DB_HOST=localhost
DB_NAME=laundry_db
DB_USER=laundry_user
DB_PASSWORD=laundry_password_change_me
DB_PORT=5433

# --- BACKEND CONFIG ---
SPRING_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=dev-secret-change-in-production-minimum-32-characters-required
ALLOWED_ORIGIN=http://localhost:3001
ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:3001,https://*.ngrok-free.app

# --- SEED DATA (dev profile only) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
SEED_STAFF_USERNAME=staff
SEED_STAFF_PASSWORD_HASH=replace_with_bcrypt_hash
# Raw passwords for DemoDataSeeder (dev profile only)
APP_SEED_ADMIN_PASSWORD=admin123
APP_SEED_STAFF_PASSWORD=staff123

# --- FRONTEND CONFIG ---
FRONTEND_PORT=3001
# Docker full stack (frontend container): http://backend:8080/api
# Host dev (npm run dev in frontend/): http://localhost:8080/api — see frontend/.env.local.example
NEXT_PUBLIC_API_URL=http://backend:8080/api

# --- SYSTEM ---
VERSION=latest

# --- SMS CONFIG (Semaphore.co) ---
SEMAPHORE_API_KEY=your_api_key_here
SEMAPHORE_SENDER_NAME=FaithLaundry

# ============================================================
# RENDER PRODUCTION CHECKLIST
# ============================================================
# Set these environment variables in Render Dashboard:
#
# REQUIRED:
#   SPRING_PROFILES_ACTIVE    = prod
#   DB_HOST                   = <neon-host>.neon.tech
#   DB_PORT                   = 5432
#   DB_NAME                   = faith-laundry-shop
#   DB_USER                   = neondb_owner
#   DB_PASSWORD               = <neon-password>
#   JWT_SECRET                = <random-64-char-string>
#   ALLOWED_ORIGIN            = https://your-vercel-app.vercel.app
#   ALLOWED_ORIGIN_PATTERNS   = https://your-vercel-app.vercel.app,https://*.vercel.app
#
# Neon SSL is enabled automatically when SPRING_PROFILES_ACTIVE=prod (application-prod.yml).
#
# KEEP-ALIVE (Render free tier — prevents 15 min spin-down):
#   Primary:  UptimeRobot → https://your-backend.onrender.com/actuator/health every 5 min
#   Backup:   GitHub secret RENDER_BACKEND_URL → .github/workflows/maintenance.yml
#
# OPTIONAL:
#   SEMAPHORE_API_KEY         = <your-api-key>
#   SEMAPHORE_SENDER_NAME     = FaithLaundry
# ============================================================
