# ============================================================
# Faith Laundry Shop — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#
# LOCAL DEV:   Uses Docker Compose (docker-compose.yml)
# PRODUCTION:  Set these on the Windows shop host.
# ============================================================

# --- DATABASE CONFIG ---
# DB_HOST: 'localhost' for host-dev (run_dev.cmd), overridden to 'db' by docker-compose.yml
DB_HOST=localhost
DB_NAME=laundry_db
DB_USER=laundry_user
DB_PASSWORD=laundry_password_change_me
# DB_PORT: Host-exposed port (maps to Postgres internal 5432 inside Docker)
DB_PORT=5433

# --- BACKEND CONFIG ---
SPRING_PORT=8080
BACKEND_PORT=8080
DEBUG_PORT=5006
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=dev-secret-change-in-production-minimum-32-characters-required
ALLOWED_ORIGIN=http://localhost:3000

# --- SEED DATA (handled by Flyway dev profile) ---
# Note: Admin and Staff seed credentials are in backend/src/main/resources/db/migration/dev/R__demo_data.sql

# --- SYSTEM ---
VERSION=latest

# --- SMS CONFIG (Semaphore.co) ---
SEMAPHORE_API_KEY=your_api_key_here
SEMAPHORE_SENDER_NAME=FaithLaundry

# ============================================================
# WINDOWS SHOP-HOST PRODUCTION CHECKLIST
# ============================================================
# Set these values in the installer-generated application configuration:
#
# REQUIRED:
#   SPRING_PROFILES_ACTIVE    = prod
#   DB_HOST                   = 127.0.0.1
#   DB_PORT                   = 5432
#   DB_NAME                   = laundry_db
#   DB_USER                   = laundry_user
#   DB_PASSWORD               = <generated-strong-password>
#   JWT_SECRET                = <random-64-char-string>
#   ALLOWED_ORIGIN            = https://<your-vercel-production-domain>
#
# The Vercel frontend and Ngrok endpoint are configured outside this file.
# Do not place NEXT_PUBLIC_API_URL or UPSTREAM_API_URL in this backend template.
#
# OPTIONAL:
#   SEMAPHORE_API_KEY         = <your-api-key>
#   SEMAPHORE_SENDER_NAME     = FaithLaundry
# ============================================================
