# ============================================================
# Faith Laundry Shop — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#
# LOCAL DEV:   Uses Docker Compose (docker-compose.yml)
# PRODUCTION:  Do NOT copy this .env to the Windows shop host; the installer generates production config.
# ============================================================

# --- DATABASE CONFIG ---
# DB_HOST: 'localhost' for host-dev (run_dev.cmd), overridden to 'db' by docker-compose.yml
DB_HOST=localhost
DB_NAME=laundry_db
DB_USER=laundry_user
DB_PASSWORD=laundry_password_change_me
# DB_PORT: Host-exposed port (maps to Postgres internal 5432 inside Docker)
DB_PORT=5433

# --- BACKEND CONFIG ---
SPRING_PORT=8080
BACKEND_PORT=8080
DEBUG_PORT=5006
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=dev-secret-change-in-production-minimum-32-characters-required
ALLOWED_ORIGIN=http://localhost:3000
FORWARD_HEADERS_STRATEGY=none

# --- SEED DATA (handled by Flyway dev profile) ---
# Note: Admin and Staff seed credentials are in backend/src/main/resources/db/migration/dev/R__demo_data.sql

# --- SYSTEM ---
VERSION=latest

# --- SMS CONFIG (Semaphore.co) ---
SEMAPHORE_API_KEY=your_api_key_here
SEMAPHORE_SENDER_NAME=FaithLaundry

# ============================================================
# WINDOWS SHOP-HOST PRODUCTION NOTES
# ============================================================
# The production installer does not use this .env file. It writes:
#   C:\ProgramData\LaundryShopMS\config\application-prod.properties
#
# The generated production configuration uses:
#   database            = laundryms
#   database role       = laundryms_app
#   server.address      = 127.0.0.1
#   server.port         = 8765
#   forwarded headers   = framework
#   allowed origins     = local app + configured Ngrok origin + remote frontend origin
#
# Ngrok secrets are stored separately in:
#   C:\ProgramData\LaundryShopMS\tunnel\ngrok.yml
#
# Vercel keeps its own environment variable:
#   UPSTREAM_API_URL=https://<configured-ngrok-static-domain>
#
# Never store production DB/JWT/Ngrok secrets in this development .env template.
# ============================================================
