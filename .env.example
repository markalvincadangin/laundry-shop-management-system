# --- DATABASE CONFIG ---
DB_NAME=laundry_db
DB_USER=laundry_user
DB_PASSWORD=laundry_password_change_me
DB_PORT=5433

# --- BACKEND CONFIG ---
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=dev-secret-change-in-production-min-32-chars
ALLOWED_ORIGIN=http://localhost:3000
# Set to false and true respectively to wipe the database on next startup
SPRING_FLYWAY_CLEAN_DISABLED=true
SPRING_FLYWAY_CLEAN_ON_STARTUP=false

# --- SEED DATA ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
SEED_STAFF_USERNAME=staff
SEED_STAFF_PASSWORD_HASH=replace_with_bcrypt_hash

# --- SYSTEM ---
VERSION=latest

# --- SMS CONFIG (Semaphore.co) ---
SEMAPHORE_API_KEY=your_api_key_here
SEMAPHORE_SENDER_NAME=FaithLaundry
