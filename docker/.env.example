# Faith Laundry Shop Management System — Docker Environment Template
# Copy to .env.docker in this folder for Docker Compose. NEVER commit .env.docker to Git.
# See docs/GETTING_STARTED.md for setup instructions.
#
# Usage: Run from project root with:
#   docker compose -f docker/docker-compose.yml --env-file docker/.env.docker up -d
#
# PRODUCTION (docker-compose.prod.yml): Set DB_PASSWORD, JWT_SECRET (≥32 chars),
# ALLOWED_ORIGIN (e.g. http://192.168.1.100), NEXT_PUBLIC_API_URL (e.g. http://192.168.1.100/api)

# Database Configuration
DB_USER=laundry_user
DB_PASSWORD=your_secure_password_here
DB_PORT=5433
DB_NAME=laundry_db

