# Faith Laundry Shop — Frontend Environment Template
# Copy to frontend/.env.local for development. NEVER commit .env.local to Git.

# Base URL for Backend API requests (Exposed to browser via NEXT_PUBLIC_ prefix)
# Dev: http://localhost:8080/api
# Prod: /api (if using Nginx reverse proxy)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Local Port override (optional)
# PORT=3000
