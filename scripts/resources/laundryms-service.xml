<service>
  <id>LaundryShopMS</id>
  <name>Laundry Shop Management System</name>
  <description>Local Laundry Shop Management System application service.</description>

  <executable>%BASE%\runtime\bin\java.exe</executable>
  <arguments>-Dfile.encoding=UTF-8 -jar "%BASE%\laundryms.jar" --spring.profiles.active=prod --spring.config.additional-location="file:C:/ProgramData/LaundryShopMS/config/application-prod.properties"</arguments>
  <workingdirectory>%BASE%</workingdirectory>

  <serviceaccount>
    <username>LocalSystem</username>
  </serviceaccount>

  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <autoRefresh>true</autoRefresh>
  <stoptimeout>30 sec</stoptimeout>
  <hidewindow>true</hidewindow>

  <logpath>C:\ProgramData\LaundryShopMS\logs</logpath>
  <log mode="roll-by-time">
    <pattern>yyyyMMdd</pattern>
    <keepFiles>14</keepFiles>
  </log>

  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
</service>
