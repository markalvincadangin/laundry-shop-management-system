<service>
  <id>LaundryShopMS</id>
  <name>Laundry Shop Management System</name>
  <description>Laundry Shop Management System - Local POS Server</description>
  <executable>java</executable>
  <arguments>-Xmx512m -jar "%BASE%\laundryms.jar" --spring.profiles.active=prod --spring.config.additional-location="%BASE%\config\application-prod.properties"</arguments>
  <logpath>%BASE%\logs</logpath>
  <logmode>rotate</logmode>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="20 sec"/>
  <onfailure action="none"/>
  <startmode>Automatic</startmode>
  <delayedAutoStart>false</delayedAutoStart>
  <stoptimeout>30 sec</stoptimeout>
</service>
