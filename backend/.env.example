# Backend Environment Template — Faith Laundry Shop Management System
# Copy to backend/.env and fill in values. NEVER commit .env to Git.
# Run backend from backend/ directory: .\mvnw.cmd spring-boot:run

# Database Configuration (must match docker/docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=laundry_db
DB_USER=laundry_user
DB_PASSWORD=your_secure_password_here

# Backend Configuration
SPRING_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=replace_with_a_minimum_32_character_random_secret
ALLOWED_ORIGIN=http://localhost:3000

# Flyway Database Reset (Advanced)
# To wipe and re-initialize the DB: set CLEAN_DISABLED=false and CLEAN_ON_STARTUP=true
SPRING_FLYWAY_CLEAN_DISABLED=true
SPRING_FLYWAY_CLEAN_ON_STARTUP=false

# Optional dev seed users (recommended for local testing)
# Generate BCrypt hashes and set values below to enable V2 seed user creation.
SEED_ADMIN_USERNAME=ADMIN
SEED_ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
SEED_STAFF_USERNAME=staff
SEED_STAFF_PASSWORD_HASH=replace_with_bcrypt_hash
