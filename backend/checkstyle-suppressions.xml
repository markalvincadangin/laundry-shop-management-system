<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- Suppress Javadoc requirement for all test classes -->
    <suppress checks="Javadoc.*|MissingJavadoc.*" files="src[/\\]test[/\\].*"/>

    <!-- Allow test classes to exceed standard 500-line file length limit for comprehensive test suites -->
    <suppress checks="FileLength" files="src[/\\]test[/\\].*"/>
</suppressions>
